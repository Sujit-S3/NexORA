# NexORA v1.0.0 Backend Environment Variables
# Copy this file to .env and fill in all values before deployment.
# Lines marked REQUIRED must be set — the server will refuse to start without them.
# Lines marked OPTIONAL can be omitted if you are not using that feature.

# ── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development          # REQUIRED: development | production
PORT=5000                     # REQUIRED

# ── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED: Get your connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/NexORA?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED: Use strong random secrets (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_generate_with_crypto
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_chars_different_from_above
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS / Client URL ─────────────────────────────────────────────────────────
# REQUIRED: Used for CORS policy, password reset URLs, and welcome email links
# Development:  http://localhost:5173
# Production:   https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
# REQUIRED: Create a free account at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── AI Provider (Google Gemini) ────────────────────────────────────────────────
# REQUIRED: Get your API key at https://aistudio.google.com/
# Used for: AI Concierge (Flash), Admin AI Studio (Pro), comparisons
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL: undocumented fallback read by aiService.js if GEMINI_API_KEY is unset —
# prefer GEMINI_API_KEY above; this alias exists only for backwards compatibility.
# GOOGLE_AI_KEY=

# ── AI Catalog Versioning ─────────────────────────────────────────────────────
# Increment this when products/prices/inventory change to invalidate the AI cache
CATALOG_VERSION=1

# ── Email Service (Resend) ────────────────────────────────────────────────────
# REQUIRED in production: Get your API key at https://resend.com/
# In development: emails are logged to console — no key needed
# In production: missing key = password reset emails silently fail
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=NexORA <noreply@yourdomain.com>
# OPTIONAL: Inbox the public Contact form forwards submissions to. Defaults
# to support@nexora.app if unset.
CONTACT_EMAIL=support@yourdomain.com

# ── Razorpay (Payment Gateway) ────────────────────────────────────────────────
# OPTIONAL: If omitted, only Cash on Delivery is accepted at checkout.
# Get instant test-mode keys (no KYC required) at https://dashboard.razorpay.com/
# Both KEY_ID and KEY_SECRET must be set together, or both left unset.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret configured in Razorpay Dashboard > Settings > Webhooks
# Required for POST /api/payments/webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
# OPTIONAL: If omitted, only console.error logging is available — no alerting.
# Create a free project at https://sentry.io/ (Node.js platform) to get a DSN.
SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
