# NexORA — .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables
.env
.env.local
.env.*.local
.env.staging
.env.production
.env.development

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/

# Temp
tmp/
temp/

*.webp
*.py
nul.css
tools/

# QA and Test Scratch Files
check*.js
fix*.js
test_*.js
*.cjs
out.txt
eslint-report.json

# Generated audit/migration report snapshots (regenerate via server/src/scripts/*.js)
server/src/scripts/*_report.json
